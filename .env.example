# ==============================================================================
# J.A.R.V.I.S. Architecture Environment Configuration
# ==============================================================================
# This file contains the configuration variables used by the Medusa AI Assistant.
# Copy this file to '.env' and fill in the values according to your environment.
# DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# n8n Orchestration Settings (REQUIRED)
# ------------------------------------------------------------------------------
# The full URL to your n8n Webhook node that acts as the "brain".
# Example: http://localhost:5678/webhook/assistant
# Example: https://your-n8n-domain.com/webhook/assistant
N8N_WEBHOOK_URL="http://localhost:5678/webhook/assistant"

# ------------------------------------------------------------------------------
# Assistant Persona Settings (OPTIONAL)
# ------------------------------------------------------------------------------
# The name your assistant goes by.
# Default: Ashley
ASSISTANT_NAME="J.A.R.V.I.S."

# ------------------------------------------------------------------------------
# Text-to-Speech (TTS) Settings (OPTIONAL)
# ------------------------------------------------------------------------------
# The Edge-TTS voice identifier.
# Common voices: en-US-MichelleNeural, en-GB-RyanNeural, en-US-GuyNeural
# Default: en-US-MichelleNeural
TTS_VOICE="en-GB-RyanNeural"

# ------------------------------------------------------------------------------
# Speech-to-Text (STT) Settings (OPTIONAL)
# ------------------------------------------------------------------------------
# The expected language for speech recognition.
# Default: en-US
STT_LANGUAGE="en-US"

# ------------------------------------------------------------------------------
# Logging & Runtime Settings (OPTIONAL)
# ------------------------------------------------------------------------------
# Level of logging output (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL="INFO"
